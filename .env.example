# ==========================================
# StudentOS AI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="StudentOS AI"
APP_ENV=development
APP_URL=http://localhost/StudentOS-AI-project
DEBUG=true

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studentos_ai
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Authentication & Security
JWT_SECRET=StudentOS_AI_Super_Secure_JWT_Key_2026_Enterprise_Security
JWT_EXPIRY=604800
SESSION_TIMEOUT=86400
SESSION_LIFETIME=86400
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
ENABLE_RAG=true

# Storage & Uploads
STORAGE_PATH=storage
UPLOAD_PATH=storage/uploads
MAX_FILE_SIZE=20971520

# Mail / SMTP Settings (Mailtrap or standard SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@studentos.ai
MAIL_FROM_NAME="StudentOS AI"
